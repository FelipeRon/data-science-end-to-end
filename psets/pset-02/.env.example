# Local: copiar a .env. Codespaces: bash scripts/codespaces.sh prepare lo genera.
# La clave privada NUEVA se obtiene de SECRET_SNOWFLAKE_PRIVATE_KEY (Base64)
# en Codespaces Secrets. Nunca guardar claves reales en este archivo.
SNOWFLAKE_ACCOUNT=MRIWLBX-HH95628
SNOWFLAKE_USER=PSET2_KESTRA
SNOWFLAKE_ROLE=PSET2_INGEST
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2_MANTENIMIENTO
# La clave privada existente se monta en solo lectura; no pegarla aquí.
SNOWFLAKE_PRIVATE_KEY_FILE=/run/secrets/snowflake.p8
# Contraseña de cifrado codificada en Base64; vacía si la clave no está cifrada.
# Esta codificación permite caracteres especiales en dotenv; sigue siendo un secreto.
SNOWFLAKE_PRIVATE_KEY_PASSWORD_B64=
KESTRA_USER=admin@kestra.io
KESTRA_PASSWORD=Admin1234


