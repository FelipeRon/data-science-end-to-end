", "completed_at": "2026-11-12T15:14:10.877409Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.5250604152679443, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d6a7-0001-77be00181522"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.pset2_ai4i.stg_ai4i", "compiled": true, "compiled_code": "-- Conversi\u00f3n expl\u00edcita; los fallos de conversi\u00f3n se vuelven NULL y son auditables.\nselect\n    md5(source_sha256 || '|' || udi) as reading_key,\n    try_to_number(udi)::integer as udi,\n    nullif(trim(product_id), '') as product_id,\n    upper(nullif(trim(type), '')) as product_type,\n    try_to_double(air_temperature_k) as air_temperature_k,\n    try_to_double(process_temperature_k) as process_temperature_k,\n    try_to_number(rotational_speed_rpm)::integer as rotational_speed_rpm,\n    try_to_double(torque_nm) as torque_nm,\n    try_to_number(tool_wear_min)::integer as tool_wear_min,\n    try_to_number(machine_failure)::integer as machine_failure,\n    try_to_number(twf)::integer as twf,\n    try_to_number(hdf)::integer as hdf,\n    try_to_number(pwf)::integer as pwf,\n    try_to_number(osf)::integer as osf,\n    try_to_number(rnf)::integer as rnf,\n    source_sha256, source_url, batch_id, loaded_at\nfrom PSET2_MANTENIMIENTO.RAW.AI4I_OBSERVATIONS", "relation_name": "PSET2_MANTENIMIENTO.BRONZE.stg_ai4i", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-12T15:14:10.885540Z", "completed_at": "2026-11-12T15:14:10.889603Z"}, {"name": "execute", "started_at": "2026-11-12T15:14:10.889896Z", "completed_at": "2026-11-12T15:14:11.243711Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.36187744140625, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d6b3-0001-77be0017ca82"}, "message": null, "failures": 0, "unique_id": "test.pset2_ai4i.unique_stg_ai4i_reading_key.1f483a22a0", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    reading_key as unique_field,\n    count(*) as n_records\n\nfrom PSET2_MANTENIMIENTO.BRONZE.stg_ai4i\nwhere reading_key is not null\ngroup by reading_key\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-12T15:14:10.882864Z", "completed_at": "2026-11-12T15:14:10.891475Z"}, {"name": "execute", "started_at": "2026-11-12T15:14:10.891875Z", "completed_at": "2026-11-12T15:14:11.309414Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.42815208435058594, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d6a7-0001-77be0018152a"}, "message": null, "failures": 0, "unique_id": "test.pset2_ai4i.not_null_stg_ai4i_reading_key.c382a95f53", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect reading_key\nfrom PSET2_MANTENIMIENTO.BRONZE.stg_ai4i\nwhere reading_key is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-12T15:14:11.312366Z", "completed_at": "2026-11-12T15:14:11.314634Z"}, {"name": "execute", "started_at": "2026-11-12T15:14:11.314883Z", "completed_at": "2026-11-12T15:14:11.980206Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.6686904430389404, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d622-0001-77be0017f7da"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.pset2_ai4i.int_ai4i_quality", "compiled": true, "compiled_code": "\nselect *,\n    case\n        when udi is null or udi <= 0 then 'invalid_udi'\n        when product_id is null or product_type is null then 'missing_product'\n        when product_type not in ('L', 'M', 'H') then 'invalid_type'\n        when left(product_id, 1) <> product_type then 'inconsistent_product_type'\n        when air_temperature_k is null or process_temperature_k is null\n          or rotational_speed_rpm is null or torque_nm is null or tool_wear_min is null\n            then 'missing_or_invalid_measurement'\n        when air_temperature_k <= 0 or process_temperature_k <= 0\n          or rotational_speed_rpm <= 0 or torque_nm < 0 or tool_wear_min < 0\n            then 'out_of_domain_measurement'\n        when machine_failure is null or twf is null or hdf is null\n          or pwf is null or osf is null or rnf is null then 'missing_failure_flag'\n        when machine_failure not in (0,1) or twf not in (0,1) or hdf not in (0,1)\n          or pwf not in (0,1) or osf not in (0,1) or rnf not in (0,1)\n            then 'invalid_failure_flag'\n        else null\n    end as rejection_reason,\n    -- Se informa, no se reescribe el target: los flags no son una verdad independiente.\n    case when machine_failure <> greatest(twf, hdf, pwf, osf, rnf)\n         then 1 else 0 end as failure_flag_mismatch\nfrom PSET2_MANTENIMIENTO.BRONZE.stg_ai4i", "relation_name": "PSET2_MANTENIMIENTO.SILVER.int_ai4i_quality", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-12T15:14:11.988264Z", "completed_at": "2026-11-12T15:14:12.009077Z"}, {"name": "execute", "started_at": "2026-11-12T15:14:12.009640Z", "completed_at": "2026-11-12T15:14:12.568880Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.5848052501678467, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d622-0001-77be0017f7de"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.pset2_ai4i.ai4i_rejected", "compiled": true, "compiled_code": "\nselect * from PSET2_MANTENIMIENTO.SILVER.int_ai4i_quality where rejection_reason is not null", "relation_name": "PSET2_MANTENIMIENTO.SILVER.ai4i_rejected", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-12T15:14:12.571202Z", "completed_at": "2026-11-12T15:14:12.573539Z"}, {"name": "execute", "started_at": "2026-11-12T15:14:12.573915Z", "completed_at": "2026-11-12T15:14:13.042533Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.4718320369720459, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d6b3-0001-77be0017ca8a"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.pset2_ai4i.quality_report", "compiled": true, "compiled_code": "\nselect source_sha256,\n    count(*) as source_rows,\n    count_if(rejection_reason is not null) as rejected_rows,\n    count_if(rejection_reason is null) as valid_rows,\n    count_if(rejection_reason = 'missing_product') as missing_product_rows,\n    count_if(rejection_reason = 'missing_or_invalid_measurement') as invalid_measurement_rows,\n    sum(failure_flag_mismatch) as failure_flag_mismatches,\n    count(*) - count(distinct reading_key) as duplicate_keys,\n    sum(machine_failure) as machine_failure_rows,\n    avg(machine_failure) as failure_rate,\n    min(air_temperature_k) as min_air_temperature_k,\n    max(air_temperature_k) as max_air_temperature_k,\n    min(torque_nm) as min_torque_nm,\n    max(torque_nm) as max_torque_nm\nfrom PSET2_MANTENIMIENTO.SILVER.int_ai4i_quality\ngroup by source_sha256", "relation_name": "PSET2_MANTENIMIENTO.SILVER.quality_report", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-12T15:14:11.985129Z", "completed_at": "2026-11-12T15:14:11.991145Z"}, {"name": "execute", "started_at": "2026-11-12T15:14:11.991620Z", "completed_at": "2026-11-12T15:14:13.198862Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.2151572704315186, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d6b3-0001-77be0017ca86"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.pset2_ai4i.ai4i_clean", "compiled": true, "compiled_code": "select * exclude rejection_reason\nfrom PSET2_MANTENIMIENTO.SILVER.int_ai4i_quality\nwhere rejection_reason is null", "relation_name": "PSET2_MANTENIMIENTO.SILVER.ai4i_clean", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-12T15:14:13.205869Z", "completed_at": "2026-11-12T15:14:13.209234Z"}, {"name": "execute", "started_at": "2026-11-12T15:14:13.211094Z", "completed_at": "2026-11-12T15:14:13.605947Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.4037449359893799, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d6b3-0001-77be0017ca8e"}, "message": null, "failures": 0, "unique_id": "test.pset2_ai4i.accepted_values_ai4i_clean_product_type__L__M__H.91645bcd4b", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        product_type as value_field,\n        count(*) as n_records\n\n    from PSET2_MANTENIMIENTO.SILVER.ai4i_clean\n    group by product_type\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'L','M','H'\n)\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-12T15:14:13.203195Z", "completed_at": "2026-11-12T15:14:13.208938Z"}, {"name": "execute", "started_at": "2026-11-12T15:14:13.209534Z", "completed_at": "2026-11-12T15:14:13.614654Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.4127936363220215, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85d32-0001-d6a7-0001-77be00181532"}, "message": null, "failures": 0, "unique_id": "test.pset2_ai4i.accepted_values_ai4i_clean_machine_failure__False__0__1.d15ed33323", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        machine_failure as value_field,\n        count(*) as n_records\n\n    from PSET2_MANTENIMIENTO.SILVER.ai4i_clean\n    group by machine_failure\